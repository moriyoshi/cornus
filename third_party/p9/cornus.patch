+// getReadBuf and putReadBuf borrow an msize-shaped buffer for this connection,
+// through a one-slot GC-proof cache in front of readBufPool.
+//
+// Cornus fork addition, and the reason it exists is measured rather than
+// theoretical. A sync.Pool is emptied completely by every collection, and on a
+// bulk 9P path the pool's OWN misses are what drive the next collection: a miss
+// allocates a whole msize buffer, that allocation brings the collector round, and
+// the collector empties the pool again before the next request. Profiling a
+// sequential write showed this pool's New accounting for a THIRD of all bytes
+// allocated on the path, with only one request in flight at a time — so it was
+// not contention, it was the pool never surviving to be reused.
+//
+// One slot, not a pool of them, and not the concurrency bound: the steady state
+// of sequential I/O is one buffer in flight, a slot costs msize of permanently
+// pinned memory per connection (the same order as pristineZeros, which this
+// connection already holds), and anything beyond that is better left to the
+// sync.Pool below, which returns idle memory. Bursts fall through to it and are
+// unaffected.
+func (cs *connState) getReadBuf() *[]byte {
+	if bp := cs.readBufHot.Swap(nil); bp != nil {
+		return bp
+	}
+	return cs.readBufPool.Get().(*[]byte)
+}
